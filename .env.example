# polskiprimal.pl — environment variables (Phase 1, Option A)
# Copy to `.env` and fill in. The app starts even if these are absent (R1.5);
# S3_BUCKET and AWS_REGION are required only when STORAGE_BACKEND=s3 is actually used
# (the app fails with a clear message on first storage access if they are missing).

# --- Core app ---
APP_ENV=dev                       # dev | prod
SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=http://localhost:8000    # production: https://polskiprimal.pl

# --- Storage selection ---
STORAGE_BACKEND=s3                # s3 (Option A) | memory (dev/tests only, data lost on restart)
                                  # Later: dynamodb | postgres

# --- Amazon S3 (Option A storage) ---
S3_BUCKET=polskiprimal-data       # required for s3
AWS_REGION=eu-central-1           # required for s3
# Leave both blank to use an IAM role / default AWS credential chain; otherwise set both.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: S3-compatible server such as local MinIO (create the bucket first).
# S3_ENDPOINT_URL=http://localhost:9000

# --- Optional / future (safe to leave blank in Phase 1) ---
# DATABASE_URL=postgresql+asyncpg://user:password@hostname:5432/dbname
# BLIK_API_KEY=
# PRZELEWY24_MERCHANT_ID=
# PRZELEWY24_API_KEY=

# --- Docker / Caddy (docker-compose.yml) ---
# Leave SITE_ADDRESS unset for plain HTTP on http://localhost. For production set your domain(s);
# Caddy then obtains and renews Let's Encrypt certificates automatically (see DEPLOY.md).
# SITE_ADDRESS="polskiprimal.pl, www.polskiprimal.pl"
# HTTP_PORT=80                    # change if port 80 is taken locally
# HTTPS_PORT=443
# Only for the optional MinIO profile (docker compose --profile minio up):
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
